# === Groq (AI) — wajib ===
# API key dari https://console.groq.com/keys (ada free tier)
GROQ_API_KEY=gsk_...
# Opsional: override model vision Groq
# GROQ_MODEL=...

# === Supabase (auth + riwayat) — wajib ===
# Dari dashboard Supabase project "belajarin" (bukan rahasia, aman di client)
NEXT_PUBLIC_SUPABASE_URL=https://djlwfwogehlwpttjbafx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Opsional: jumlah panduan gratis per user per hari (default 3, reset 00.00 WIB)
# DAILY_QUOTA=3

# Opsional: jatah harian untuk user Premium (default 30)
# PREMIUM_DAILY_QUOTA=30

# === Pembayaran: transfer bank + konfirmasi bot Telegram ===
# Service-role key Supabase — dipakai server untuk mengaktifkan premium
# setelah admin menyetujui pembayaran. RAHASIA, jangan diekspos ke client.
SUPABASE_SERVICE_ROLE_KEY=

# Bot Telegram (server-only). Token dari @BotFather, chat id admin dari @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Secret bebas (mis. hasil `openssl rand -hex 16`) — dipakai memvalidasi webhook.
TELEGRAM_WEBHOOK_SECRET=

# Harga premium (server, untuk validasi nominal). Default 25000.
# PREMIUM_PRICE_IDR=25000

# Info rekening yang ditampilkan ke user (aman tampil di client).
NEXT_PUBLIC_BANK_NAME=BCA
NEXT_PUBLIC_BANK_ACCOUNT=0000000000
NEXT_PUBLIC_BANK_HOLDER=Admin Belajarin
# NEXT_PUBLIC_PREMIUM_PRICE_IDR=25000
