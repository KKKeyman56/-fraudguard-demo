# === Groq (AI) — wajib ===
# API key dari https://console.groq.com/keys (ada free tier)
GROQ_API_KEY=gsk_...
# Opsional: override model vision Groq
# GROQ_MODEL=...

# === Supabase (auth + riwayat) — wajib ===
# Dari dashboard Supabase project "belajarin" (bukan rahasia, aman di client)
NEXT_PUBLIC_SUPABASE_URL=https://djlwfwogehlwpttjbafx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Opsional: jumlah panduan gratis per user per hari (default 3, reset 00.00 WIB)
# DAILY_QUOTA=3

# Opsional: jatah harian untuk user Premium (default 30)
# PREMIUM_DAILY_QUOTA=30

# === PayPal (payment gateway) — wajib kalau mau terima pembayaran online ===
# Kredensial dari https://developer.paypal.com/dashboard/applications
# Server-only (rahasia):
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# "sandbox" untuk uji coba, "live" untuk produksi (default sandbox)
# PAYPAL_ENV=sandbox
# Catatan: PayPal TIDAK mendukung IDR, jadi premium ditagih dalam USD.
# PREMIUM_PRICE_USD=1.99
# PREMIUM_CURRENCY=USD
# PREMIUM_DURATION_DAYS=30

# Service-role key Supabase — dipakai server untuk mengaktifkan premium
# setelah pembayaran terverifikasi. RAHASIA, jangan pernah diekspos ke client.
SUPABASE_SERVICE_ROLE_KEY=

# Dipakai di browser untuk render tombol PayPal (sama dengan PAYPAL_CLIENT_ID,
# memang aman tampil di client). Display harga & mata uang juga dari sini.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# NEXT_PUBLIC_PREMIUM_PRICE_USD=1.99
# NEXT_PUBLIC_PREMIUM_CURRENCY=USD
