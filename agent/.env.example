# ── LLM provider selection ───────────────────────────────────────────────
# auto     : pakai Anthropic kalau ada key, lalu Groq, kalau tidak ada -> offline/heuristik
# anthropic: paksa Claude (butuh ANTHROPIC_API_KEY)
# groq     : paksa Groq/Llama (butuh GROQ_API_KEY)
# stub     : paksa mode offline/heuristik (tanpa API, cocok untuk demo & CI)
LLM_PROVIDER=auto

# ── Anthropic (Claude) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Default seimbang. Untuk analisis lebih dalam bisa pakai claude-opus-4-8.
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── Groq (Llama) ─────────────────────────────────────────────────────────
GROQ_API_KEY=
GROQ_MODEL=meta-llama/llama-4-maverick-17b-128e-instruct

# ── Server ───────────────────────────────────────────────────────────────
REQUEST_TIMEOUT=120
# CORS origin yang diizinkan (pisahkan dengan koma). Default: hanya localhost.
ALLOWED_ORIGINS=http://localhost:3000
